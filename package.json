{
  "engines": {
    "node": ">=24.15.0"
  },
  "name": "six-cities",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.21.1",
    "classnames": "^2.3.1",
    "dayjs": "^1.10.7",
    "history": "^5.2.0",
    "http-status-codes": "^2.3.0",
    "leaflet": "^1.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "react-redux": "^7.2.2",
    "react-router-dom": "^7.18.0",
    "react-toastify": "^11.2.0",
    "reselect": "^5.3.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint:check": "eslint --ext .tsx --ext .ts src/",
    "lint": "eslint --fix --ext .tsx --ext .ts src/",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "prepare": "husky",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@jedmao/redux-mock-store": "^3.0.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.7.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.22",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "axios-mock-adapter": "^1.19.0",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.31.11",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.6.0",
    "prettier": "^3.2.5",
    "redux-devtools-extension": "2.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "@vitejs/plugin-react": "^6.3.0",
    "vitest": "^5.1.0",
    "jsdom": "^31.0.1"
  }
}
